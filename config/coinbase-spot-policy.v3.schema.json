{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delta.network/schemas/coinbase-spot-policy-compilation.v3.json",
  "title": "delta Coinbase spot-policy compilation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "status",
    "policy",
    "ambiguities",
    "unsupported_constraints",
    "grounding"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "delta.coinbase.compilation.v3"
    },
    "taxonomy_version": {
      "type": "string",
      "const": "digital-asset-spot-order.v3"
    },
    "status": {
      "type": "string",
      "enum": [
        "READY_FOR_CONFIRMATION",
        "NEEDS_CLARIFICATION",
        "UNSUPPORTED"
      ]
    },
    "policy": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "venue",
            "environment",
            "execution_domain",
            "product_type",
            "product_id",
            "base_asset",
            "quote_asset",
            "side",
            "order_type",
            "size",
            "partial_fill_policy",
            "limits",
            "market_condition",
            "validity",
            "usage"
          ],
          "properties": {
            "venue": {
              "type": "string",
              "const": "COINBASE_ADVANCED"
            },
            "environment": {
              "type": "string",
              "const": "PRODUCTION"
            },
            "execution_domain": {
              "type": "string",
              "const": "COINBASE_CUSTODIAL_LEDGER"
            },
            "product_type": {
              "type": "string",
              "const": "SPOT"
            },
            "product_id": {
              "type": "string",
              "pattern": "^[A-Z0-9]+-[A-Z0-9]+$"
            },
            "base_asset": {
              "type": "string",
              "pattern": "^[A-Z0-9]+$"
            },
            "quote_asset": {
              "type": "string",
              "pattern": "^[A-Z0-9]+$"
            },
            "side": {
              "type": "string",
              "enum": [
                "BUY",
                "SELL"
              ]
            },
            "order_type": {
              "type": "string",
              "enum": [
                "SOR_LIMIT_IOC"
              ]
            },
            "size": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "denomination",
                "asset",
                "operator",
                "value"
              ],
              "properties": {
                "denomination": {
                  "type": "string",
                  "enum": [
                    "QUOTE",
                    "BASE"
                  ]
                },
                "asset": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]+$"
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "EXACT",
                    "MAX"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                }
              }
            },
            "partial_fill_policy": {
              "type": "string",
              "enum": [
                "ALLOW",
                "REQUIRE_FULL"
              ]
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_slippage_bps",
                "max_commission",
                "settlement"
              ],
              "properties": {
                "max_slippage_bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9999
                },
                "max_commission": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "asset",
                    "value"
                  ],
                  "properties": {
                    "asset": {
                      "type": "string",
                      "pattern": "^[A-Z0-9]+$"
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    }
                  }
                },
                "settlement": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "asset",
                    "value"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "MAX_QUOTE_DEBIT",
                        "MIN_NET_QUOTE_PROCEEDS"
                      ]
                    },
                    "asset": {
                      "type": "string",
                      "pattern": "^[A-Z0-9]+$"
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    }
                  }
                }
              }
            },
            "market_condition": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "reference",
                    "operator",
                    "asset",
                    "value"
                  ],
                  "properties": {
                    "reference": {
                      "type": "string",
                      "enum": [
                        "BEST_ASK",
                        "BEST_BID"
                      ]
                    },
                    "operator": {
                      "type": "string",
                      "enum": [
                        "AT_OR_BELOW",
                        "AT_OR_ABOVE"
                      ]
                    },
                    "asset": {
                      "type": "string",
                      "pattern": "^[A-Z0-9]+$"
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "validity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "starts",
                "ttl_seconds"
              ],
              "properties": {
                "starts": {
                  "type": "string",
                  "const": "ON_EXECUTION_CONFIRMATION"
                },
                "ttl_seconds": {
                  "type": "integer",
                  "minimum": 30,
                  "maximum": 600
                }
              }
            },
            "usage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_executions"
              ],
              "properties": {
                "max_executions": {
                  "type": "integer",
                  "const": 1
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "source_text",
          "question"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "source_text": {
            "type": "string"
          },
          "question": {
            "type": "string"
          }
        }
      }
    },
    "unsupported_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "source_text",
          "reason"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "source_text": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "grounding": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "source_quote"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "source_quote": {
            "type": "string"
          }
        }
      }
    }
  }
}
