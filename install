#!/usr/bin/env bash
set -euo pipefail

REPOSITORY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
UPGRADE=false

if (( $# > 1 )) || { (( $# == 1 )) && [[ "$1" != "--upgrade" ]]; }; then
  echo "Usage: $0 [--upgrade]" >&2
  exit 1
fi
if (( $# == 1 )); then
  UPGRADE=true
fi

compatible_node() {
  local candidate="$1"
  local candidate_major
  [[ -x "$candidate" ]] || return 1
  candidate_major="$(
    "$candidate" -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null
  )" || return 1
  [[ "$candidate_major" =~ ^[0-9]+$ ]] || return 1
  (( candidate_major >= 22 ))
}

NODE_BINARY=""
if [[ -n "${HARNESS_NODE_BINARY:-}" ]]; then
  if ! compatible_node "$HARNESS_NODE_BINARY"; then
    echo "HARNESS_NODE_BINARY must point to executable Node.js 22 or newer." >&2
    exit 1
  fi
  NODE_BINARY="$HARNESS_NODE_BINARY"
elif command -v node >/dev/null 2>&1 && \
  compatible_node "$(command -v node)"; then
  NODE_BINARY="$(command -v node)"
elif [[ -n "${HOME:-}" ]]; then
  # Codex Desktop may provide Node without adding it to the user's login PATH.
  # Inspect only the documented per-user Codex runtime cache and accept a
  # candidate after executing it and enforcing the same major-version floor.
  for codex_node_candidate in \
    "$HOME"/.cache/codex-runtimes/*/dependencies/node/bin/node; do
    if compatible_node "$codex_node_candidate"; then
      NODE_BINARY="$codex_node_candidate"
      break
    fi
  done
fi

if [[ -z "$NODE_BINARY" ]]; then
  echo "Delta Coinbase Guard requires Node.js 22 or newer." >&2
  echo "No compatible Node.js was found on PATH or in the Codex runtime cache." >&2
  echo "Install Node.js 22+, then rerun: $REPOSITORY_ROOT/install" >&2
  exit 1
fi

NODE_BINARY="$("$NODE_BINARY" -p 'require("node:fs").realpathSync(process.execPath)')"
PACKAGE_VERSION="$(
  "$NODE_BINARY" -e \
    'const p = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8")); process.stdout.write(String(p.version ?? ""));' \
    "$REPOSITORY_ROOT/package.json"
)"
if [[ ! "$PACKAGE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Delta Coinbase Guard package version is invalid." >&2
  exit 1
fi

if [[ -n "${CODEX_HOME:-}" ]]; then
  SKILLS_ROOT="$CODEX_HOME/skills"
elif [[ -n "${HOME:-}" ]]; then
  DOCUMENTED_SKILLS_ROOT="$HOME/.agents/skills"
  LEGACY_SKILLS_ROOT="$HOME/.codex/skills"
  if [[
    ! -e "$DOCUMENTED_SKILLS_ROOT/delta-coinbase-guard" &&
    ! -L "$DOCUMENTED_SKILLS_ROOT/delta-coinbase-guard" &&
    ( -e "$LEGACY_SKILLS_ROOT/delta-coinbase-guard" ||
      -L "$LEGACY_SKILLS_ROOT/delta-coinbase-guard" )
  ]]; then
    SKILLS_ROOT="$LEGACY_SKILLS_ROOT"
  else
    SKILLS_ROOT="$DOCUMENTED_SKILLS_ROOT"
  fi
else
  echo "Set CODEX_HOME or HOME so the installer can locate your Codex skills directory." >&2
  exit 1
fi

if [[ -n "${XDG_DATA_HOME:-}" ]]; then
  USER_DATA_ROOT="$XDG_DATA_HOME"
elif [[ -n "${HOME:-}" ]]; then
  USER_DATA_ROOT="$HOME/.local/share"
else
  echo "Set XDG_DATA_HOME or HOME so the installer can create its managed harness copy." >&2
  exit 1
fi
if [[ "$USER_DATA_ROOT" != /* ]]; then
  echo "The user data directory must be an absolute path." >&2
  exit 1
fi

MANAGED_PRODUCT_ROOT="$USER_DATA_ROOT/delta/coinbase-guard"
MANAGED_VERSIONS_ROOT="$MANAGED_PRODUCT_ROOT/versions"
MANAGED_HARNESS="$MANAGED_VERSIONS_ROOT/v$PACKAGE_VERSION"
MANAGED_SKILL_SOURCE="$MANAGED_HARNESS/skills/delta-coinbase-guard"
MANAGED_COPY_SCRIPT="$REPOSITORY_ROOT/scripts/install-managed-copy.mjs"

for managed_directory in "$MANAGED_PRODUCT_ROOT" "$MANAGED_VERSIONS_ROOT"; do
  if [[ -L "$managed_directory" ]]; then
    echo "Refusing to use a symlinked managed-install directory: $managed_directory" >&2
    exit 1
  fi
done
umask 077
mkdir -p "$MANAGED_VERSIONS_ROOT"

if [[ -e "$MANAGED_HARNESS" || -L "$MANAGED_HARNESS" ]]; then
  if [[ -L "$MANAGED_HARNESS" || ! -d "$MANAGED_HARNESS" ]]; then
    echo "Refusing to replace the existing managed-version path: $MANAGED_HARNESS" >&2
    exit 1
  fi
  "$NODE_BINARY" "$MANAGED_COPY_SCRIPT" verify \
    "$MANAGED_HARNESS" "$PACKAGE_VERSION"
  "$NODE_BINARY" "$MANAGED_COPY_SCRIPT" verify-source \
    "$MANAGED_HARNESS" "$REPOSITORY_ROOT" "$PACKAGE_VERSION"
  "$NODE_BINARY" "$MANAGED_COPY_SCRIPT" set-node \
    "$MANAGED_HARNESS" "$PACKAGE_VERSION" "$NODE_BINARY"
  "$NODE_BINARY" \
    "$MANAGED_HARNESS/scripts/scan-release-content.mjs" \
    "$MANAGED_HARNESS" \
    --managed-install
else
  MANAGED_STAGING="$MANAGED_VERSIONS_ROOT/.v$PACKAGE_VERSION.install.$$"
  if [[ -e "$MANAGED_STAGING" || -L "$MANAGED_STAGING" ]]; then
    echo "Refusing to reuse the existing managed-install staging path." >&2
    exit 1
  fi
  cleanup_managed_staging() {
    rm -rf -- "$MANAGED_STAGING"
  }
  trap cleanup_managed_staging EXIT HUP INT TERM
  "$NODE_BINARY" "$MANAGED_COPY_SCRIPT" create \
    "$REPOSITORY_ROOT" \
    "$MANAGED_STAGING" \
    "$PACKAGE_VERSION" \
    "$NODE_BINARY"
  "$NODE_BINARY" \
    "$MANAGED_STAGING/scripts/scan-release-content.mjs" \
    "$MANAGED_STAGING" \
    --managed-install
  if ! env HARNESS_NODE_BINARY="$NODE_BINARY" \
    "$MANAGED_STAGING/run" doctor >/dev/null; then
    echo "Managed harness validation failed before installation." >&2
    exit 1
  fi
  "$NODE_BINARY" -e \
    'require("node:fs").renameSync(process.argv[1], process.argv[2])' \
    "$MANAGED_STAGING" "$MANAGED_HARNESS"
  trap - EXIT HUP INT TERM
fi

SKILL_TARGET="$SKILLS_ROOT/delta-coinbase-guard"
mkdir -p "$SKILLS_ROOT"

if [[ -e "$SKILL_TARGET" || -L "$SKILL_TARGET" ]]; then
  if [[ -e "$SKILL_TARGET/SKILL.md" ]] && [[ "$SKILL_TARGET/SKILL.md" -ef "$MANAGED_SKILL_SOURCE/SKILL.md" ]]; then
    echo "Delta Coinbase Guard is already installed at $SKILL_TARGET"
  elif [[
    "$UPGRADE" == "true" &&
    -L "$SKILL_TARGET" &&
    -f "$SKILL_TARGET/SKILL.md"
  ]] && grep -Eq '^name:[[:space:]]*delta-coinbase-guard[[:space:]]*$' "$SKILL_TARGET/SKILL.md"; then
    UPGRADE_LINK="$SKILL_TARGET.upgrade.$$"
    trap 'rm -f "$UPGRADE_LINK"' EXIT
    ln -s "$MANAGED_SKILL_SOURCE" "$UPGRADE_LINK"
    "$NODE_BINARY" -e \
      'require("node:fs").renameSync(process.argv[1], process.argv[2])' \
      "$UPGRADE_LINK" "$SKILL_TARGET"
    trap - EXIT
    echo "Upgraded Delta Coinbase Guard at $SKILL_TARGET"
  else
    echo "Refusing to replace the existing path: $SKILL_TARGET" >&2
    if [[ -L "$SKILL_TARGET" ]] && [[ -f "$SKILL_TARGET/SKILL.md" ]]; then
      echo "If this is an older Delta Coinbase Guard symlink, rerun: $0 --upgrade" >&2
    else
      echo "Move or remove that path yourself, then rerun this installer." >&2
    fi
    exit 1
  fi
else
  INSTALL_LINK="$SKILL_TARGET.install.$$"
  trap 'rm -f "$INSTALL_LINK"' EXIT
  ln -s "$MANAGED_SKILL_SOURCE" "$INSTALL_LINK"
  "$NODE_BINARY" -e \
    'require("node:fs").renameSync(process.argv[1], process.argv[2])' \
    "$INSTALL_LINK" "$SKILL_TARGET"
  trap - EXIT
  echo "Installed Delta Coinbase Guard at $SKILL_TARGET"
fi

env HARNESS_NODE_BINARY="$NODE_BINARY" "$MANAGED_HARNESS/run" doctor
printf 'Managed harness: %s\n' "$MANAGED_HARNESS"

cat <<'NEXT_STEPS'

Installation complete.

1. The installer created a managed, versioned local copy. You may delete the
   downloaded archive and extracted release directory.
2. Codex should detect the skill automatically. If it is absent, fully quit and
   reopen Codex, then start a new chat.
3. In a fresh Codex chat, ask:

   Use $delta-coinbase-guard for a protected spot BUY or SELL dry run. Let me
   state the trade in plain English, turn it into a complete mandate, show it
   to me, and stop for my authorization. No order can be sent.

4. Review the mandate, then send this as a separate message:

   Authorize this mandate

   The Guard will return PASS/BLOCK/REVIEW, the plain-English reason, receipt
   status, and the no-order boundary directly in chat.

No Coinbase, Delta, or OpenAI credentials are required for this dry run.
NEXT_STEPS
